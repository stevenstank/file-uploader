<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folder Details</title>
    <%- include("partials/theme") %>
  </head>
  <body>
    <main class="container">
      <section class="card stack">
        <h2><%= folder.name %></h2>

        <h3>Share Folder</h3>
        <% if (shareError) { %>
          <p class="message error"><%= shareError %></p>
        <% } %>
        <% if (shareSuccess) { %>
          <p class="message success"><%= shareSuccess %></p>
        <% } %>
        <form action="/share-folder/<%= folder.id %>" method="POST" class="share-form" style="margin-left:0;">
          <label for="days">Link valid for (days)</label>
          <div class="container-row">
            <select name="days" id="days" class="share-days" required>
              <option value="1">1 day</option>
              <option value="5">5 days</option>
              <option value="10">10 days</option>
            </select>
            <span class="meta">days</span>
            <button type="submit">Share Folder</button>
          </div>
          <p class="share-help">This link will expire after the selected number of days.</p>
        </form>

        <% if (shareLink) { %>
          <p>Share link:</p>
          <p><a href="<%= shareLink %>" target="_blank" rel="noopener noreferrer"><%= shareLink %></a></p>
        <% } %>
      </section>

      <section class="card stack">
        <h3>Files In This Folder</h3>
        <% if (folder.files.length === 0) { %>
          <p>No files in this folder</p>
        <% } else { %>
          <ul class="list">
            <% folder.files.forEach(file => { %>
              <li class="list-item">
                <p><strong><%= file.name %></strong></p>
                <p class="meta"><%= file.size %> bytes</p>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <p><a href="/folders">Back to folders</a></p>
        <p><a href="/dashboard">Back to dashboard</a></p>
      </section>

      <%- include("partials/footer") %>
    </main>
  </body>
</html>
