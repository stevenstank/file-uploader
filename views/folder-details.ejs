<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folder Details</title>
  </head>
  <body>
    <h2><%= folder.name %></h2>

    <h3>Share Folder</h3>
    <% if (shareError) { %>
      <p><%= shareError %></p>
    <% } %>
    <% if (shareSuccess) { %>
      <p><%= shareSuccess %></p>
    <% } %>
    <form action="/share-folder/<%= folder.id %>" method="POST">
      <label for="days">Link duration</label>
      <select name="days" id="days" required>
        <option value="1">1 day</option>
        <option value="5">5 days</option>
        <option value="10">10 days</option>
      </select>
      <button type="submit">Share Folder</button>
    </form>

    <% if (shareLink) { %>
      <p>Share link:</p>
      <p><a href="<%= shareLink %>" target="_blank" rel="noopener noreferrer"><%= shareLink %></a></p>
    <% } %>

    <% if (folder.files.length === 0) { %>
      <p>No files in this folder</p>
    <% } %>

    <% folder.files.forEach(file => { %>
      <div>
        <p><%= file.name %></p>
        <p><%= file.size %> bytes</p>
      </div>
    <% }) %>

    <p><a href="/folders">Back to folders</a></p>
    <p><a href="/dashboard">Back to dashboard</a></p>
  </body>
</html>
