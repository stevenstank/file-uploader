<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shared Folder</title>
  </head>
  <body>
    <% if (notFound) { %>
      <h1>Share link not found</h1>
      <p>This share link does not exist.</p>
      <p><a href="/">Back to home</a></p>
    <% } else if (expired) { %>
      <h1>Link expired</h1>
      <p>This shared link expired on <%= expiresAt.toISOString() %>.</p>
      <p><a href="/">Back to home</a></p>
    <% } else { %>
      <h1>Shared Folder: <%= folder.name %></h1>
      <p>Valid until: <%= expiresAt.toISOString() %></p>

      <% if (!folder.files.length) { %>
        <p>No files in this folder.</p>
      <% } %>

      <ul>
        <% folder.files.forEach((file) => { %>
          <li><strong><%= file.name %></strong> (<%= file.size %> bytes)</li>
        <% }) %>
      </ul>

      <p><a href="/">Back to home</a></p>
    <% } %>
    <%- include("partials/footer") %>
  </body>
</html>
