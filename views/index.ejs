<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Uploader</title>
    <%- include("partials/theme") %>
  </head>
  <body>
    <main class="container">
      <section class="card center">
        <h1>File Uploader</h1>
        <p>
          Upload your files, keep them organized in folders, and access them anytime from anywhere.
          You can view or download your files easily and even share them with others.
        </p>

        <div class="button-row">
          <a class="btn-link" href="/login">Login</a>
          <a class="btn-link" href="/register">Signup</a>
        </div>
      </section>

      <section class="card">
        <h2>How it works</h2>
        <ul class="list">
          <li>Upload files from your device</li>
          <li>Optionally organize them into folders</li>
          <li>View or download anytime</li>
          <li>Share files with a link</li>
        </ul>

        <% if (currentUser) { %>
          <p class="muted">You are logged in as <%= currentUser.email %>.</p>
          <nav class="top-nav">
            <a href="/dashboard">Go to dashboard</a>
            <a href="/logout">Logout</a>
          </nav>
        <% } %>
      </section>

      <%- include("partials/footer") %>
    </main>
  </body>
</html>
