<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folders</title>
    <%- include("partials/theme") %>
  </head>
  <body>
    <main class="container">
      <section class="card">
        <h1>Your Folders</h1>

        <% if (error) { %>
          <p class="message error"><%= error %></p>
        <% } %>

        <% if (success) { %>
          <p class="message success"><%= success %></p>
        <% } %>
      </section>

      <section class="card">
        <h2>Create Folder</h2>
        <form action="/folders" method="POST" class="upload-form">
          <input name="name" type="text" placeholder="Folder name" required />
          <button type="submit">Create</button>
        </form>
      </section>

      <section class="card">
        <h2>Folder List</h2>
        <% if (!folders.length) { %>
          <p>No folders yet.</p>
        <% } else { %>
          <ul class="list">
            <% folders.forEach((folder) => { %>
              <li class="list-item">
                <a href="/folders/<%= folder.id %>"><%= folder.name %></a>
                <span class="meta">(<%= folder._count.files %> files)</span>
                <form id="form-<%= folder.id %>" action="/folders/<%= folder.id %>/delete" method="POST" class="inline">
                  <button type="button" onclick="openModal('<%= folder.id %>')">Delete</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <p><a href="/dashboard">Back to dashboard</a></p>
      </section>

      <%- include("partials/footer") %>
    </main>

    <div id="delete-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
      <div class="modal">
        <h3 id="delete-modal-title">Confirm Delete</h3>
        <p>Are you sure you want to delete this folder?</p>
        <div class="modal-actions">
          <button type="button" onclick="closeModal()">Cancel</button>
          <button type="button" onclick="confirmDelete()">Delete</button>
        </div>
      </div>
    </div>

    <script>
      let selectedFolderId = null;

      function openModal(folderId) {
        selectedFolderId = folderId;
        const modal = document.getElementById("delete-modal");
        if (modal) {
          modal.style.display = "flex";
        }
      }

      function closeModal() {
        selectedFolderId = null;
        const modal = document.getElementById("delete-modal");
        if (modal) {
          modal.style.display = "none";
        }
      }

      function confirmDelete() {
        if (!selectedFolderId) {
          return;
        }

        const form = document.getElementById("form-" + selectedFolderId);
        if (form) {
          form.submit();
        }
      }

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeModal();
        }
      });

      document.getElementById("delete-modal")?.addEventListener("click", (event) => {
        if (event.target.id === "delete-modal") {
          closeModal();
        }
      });
    </script>
  </body>
</html>
