<h1>Dashboard</h1>

<p>Hey <%= user.name %></p>

<nav>
  <% if (currentUser) { %>
    <a href="/dashboard">Dashboard</a>
    <a href="#upload">Upload</a>
    <a href="/logout">Logout</a>
  <% } else { %>
    <a href="/login">Login</a>
    <a href="/register">Signup</a>
  <% } %>
</nav>

<h2>Create Folder</h2>
<form action="/folders" method="POST">
  <input type="text" name="name" placeholder="Folder name" required />
  <button type="submit">Create Folder</button>
</form>

<h2>Your Folders</h2>
<% if (!folders.length) { %>
  <p>No folders yet.</p>
<% } %>

<% if (shareError) { %>
  <p><%= shareError %></p>
<% } %>
<% if (shareSuccess) { %>
  <p><%= shareSuccess %></p>
<% } %>
<% if (shareLink) { %>
  <p>Share link:</p>
  <p><a href="<%= shareLink %>" target="_blank" rel="noopener noreferrer"><%= shareLink %></a></p>
<% } %>

<ul>
  <% folders.forEach((folder) => { %>
    <li style="margin-bottom: 12px;">
      <strong><%= folder.name %></strong>
      <form action="/share-folder/<%= folder.id %>" method="POST" style="display:inline; margin-left: 8px;">
        <input type="number" name="days" min="1" max="365" value="1" required style="width: 70px;" />
        <button type="submit">Share Folder</button>
      </form>
    </li>
  <% }) %>
</ul>

<h2 id="upload">Upload File</h2>
<form id="upload-form" action="/upload" method="POST" enctype="multipart/form-data">
  <input id="file-input" type="file" name="file" required />

  <select id="folder-select" name="folderId">
    <option value="">No Folder</option>
    <% folders.forEach(folder => { %>
      <option value="<%= folder.id %>"><%= folder.name %></option>
    <% }) %>
  </select>

  <button type="submit">Upload</button>

</form>

<div
  id="drop-zone"
  style="margin-top: 12px; padding: 24px; border: 2px dashed #888; border-radius: 8px; text-align: center;"
>
  Drag and drop a file here to upload automatically
</div>
<div style="margin-top: 10px; width: 100%; max-width: 420px; background: #e5e7eb; border-radius: 999px; overflow: hidden; height: 12px;">
  <div id="upload-progress-bar" style="width: 0%; height: 100%; background: #2d89ef; transition: width 0.15s ease;"></div>
</div>
<p id="upload-progress-text">0%</p>
<p id="upload-status"></p>
<p>Tip: test with a larger file (for example 10MB+) to see progress move gradually on localhost.</p>

<h2>Your Files</h2>
<% if (!files.length) { %>
  <p>No files uploaded yet.</p>
<% } %>

<ul>
  <% files.forEach((file) => { %>
    <li>
      <strong><%= file.name %></strong> (<%= file.size %> bytes)
      <% if (file.folder) { %>
        - Folder: <%= file.folder.name %>
      <% } %>
      <a href="/files/<%= file.id %>">View</a>
      <a href="/files/<%= file.id %>/download">Download</a>
      <form action="/share-file/<%= file.id %>" method="POST" style="display:inline;">
        <input type="number" name="days" min="1" max="365" value="1" required style="width: 70px;" />
        <button type="submit">Share File</button>
      </form>
      <form action="/files/<%= file.id %>/delete" method="POST" style="display:inline;">
        <button type="submit">Delete</button>
      </form>
    </li>
  <% }) %>
</ul>

<script src="/js/dashboard-upload.js"></script>
