<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <%- include("partials/theme") %>
  </head>
  <body>
<main class="container">
  <section class="card">
    <h1>Dashboard</h1>
    <p>Hey <%= user.name %></p>

    <% if (uploadError) { %>
      <p class="message error"><%= uploadError %></p>
    <% } %>
    <% if (uploadSuccess) { %>
      <p class="message success"><%= uploadSuccess %></p>
    <% } %>

    <nav class="top-nav">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="#upload">Upload</a>
        <a href="/logout">Logout</a>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Signup</a>
      <% } %>
    </nav>
  </section>

  <section class="card stack">
    <h2>Create Folder</h2>
    <form action="/folders" method="POST" class="upload-form">
      <input type="text" name="name" placeholder="Folder name" required />
      <button type="submit">Create Folder</button>
    </form>
  </section>

  <section class="card stack">
    <h2>Your Folders</h2>

    <% if (shareError) { %>
      <p class="message error"><%= shareError %></p>
    <% } %>
    <% if (shareSuccess) { %>
      <p class="message success"><%= shareSuccess %></p>
    <% } %>
    <% if (shareLink) { %>
      <p>Share link:</p>
      <p><a href="<%= shareLink %>" target="_blank" rel="noopener noreferrer"><%= shareLink %></a></p>
    <% } %>

    <% if (!folders.length) { %>
      <p>No folders yet.</p>
    <% } else { %>
      <ul class="list">
        <% folders.forEach((folder) => { %>
          <li class="list-item">
            <strong><%= folder.name %></strong>
            <form action="/share-folder/<%= folder.id %>" method="POST" class="inline">
              <input type="number" name="days" min="1" max="365" value="1" required style="width: 70px;" />
              <button type="submit">Share Folder</button>
            </form>
            <form action="/folders/<%= folder.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this folder?');">
              <button type="submit">Delete Folder</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card stack" id="upload">
    <h2>Upload File</h2>
    <form id="upload-form" action="/upload" method="POST" enctype="multipart/form-data" class="upload-form">
      <input id="file-input" type="file" name="file" required />

      <select id="folder-select" name="folderId">
        <option value="">No Folder</option>
        <% folders.forEach(folder => { %>
          <option value="<%= folder.id %>"><%= folder.name %></option>
        <% }) %>
      </select>

      <button id="upload-button" type="submit" disabled>Upload</button>
    </form>

    <div id="drop-zone">Drag and drop a file here to preview before upload</div>
    <div id="file-preview">
      <p><strong>Selected File:</strong> <span id="preview-name"></span></p>
      <p><strong>Size:</strong> <span id="preview-size"></span></p>
    </div>

    <div class="progress-track">
      <div id="upload-progress-bar"></div>
    </div>
    <p id="upload-progress-text">0%</p>
    <p id="upload-status"></p>
    <p>Drop or choose a file, preview it, optionally select a folder, then click Upload.</p>
  </section>

  <section class="card stack">
    <h2>Your Files</h2>

    <% if (!files.length) { %>
      <p>No files uploaded yet.</p>
    <% } else { %>
      <ul class="list">
        <% files.forEach((file) => { %>
          <li class="list-item">
            <strong><%= file.name %></strong>
            <span class="meta">(<%= file.size %> bytes)</span>
            <% if (file.folder) { %>
              <span class="meta">- Folder: <%= file.folder.name %></span>
            <% } %>
            <% if (file.url) { %>
              <a href="/files/download/<%= file.id %>" class="inline">Download</a>
            <% } else { %>
              <span class="meta">URL missing</span>
            <% } %>
            <form action="/share-file/<%= file.id %>" method="POST" class="inline">
              <input type="number" name="days" min="1" max="365" value="1" required style="width: 70px;" />
              <button type="submit">Share File</button>
            </form>
            <form action="/files/<%= file.id %>/delete" method="POST" class="inline">
              <button type="submit">Delete</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <footer class="footer">
    made with ❤️ by <a href="https://github.com/stevenstank" target="_blank" rel="noopener noreferrer">stevenstank</a>
  </footer>
</main>

<script src="/js/dashboard-upload.js"></script>
  </body>
</html>
